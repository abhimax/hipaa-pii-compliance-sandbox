{
  "name": "hipaa-pii-compliance-sandbox",
  "version": "1.0.0",
  "private": true,
  "description": "Local TypeScript microservices sandbox for testing a HIPAA (PHI) / PII compliance check agent.",
  "type": "module",
  "workspaces": [
    "patient-service",
    "notification-service"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -n patient,notify -c cyan,magenta \"npm run dev -w patient-service\" \"npm run dev -w notification-service\"",
    "build": "npm run build --workspaces",
    "start": "concurrently -n patient,notify -c cyan,magenta \"npm run start -w patient-service\" \"npm run start -w notification-service\"",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test --workspaces",
    "test:unit": "npm run test:unit --workspaces",
    "test:integration": "npm run test:integration --workspaces",
    "db:init": "npm run db:init --workspaces",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^30.5.2",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^16.4.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1"
  }
}
